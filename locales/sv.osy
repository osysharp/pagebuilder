  text "Only a draft can be changed — open the region to edit it." => "Bara ett utkast kan ändras – öppna ytan för att redigera den.";

  // ── SiteLook ──
  /// SiteLook · a control's name for screen readers
  accessibleName "Site preview" => "Förhandsvisning av sajten";
  /// SiteLook · a button's label · at most ~30 characters
  /// shown through Button.label
  /// beside: "Only you see this. Orders and payments are off while you preview."
  button "Back to the live site" => "Tillbaka till livesajten";
  /// SiteLook · text on the page
  /// beside: "Back to the live site"
  text "Only you see this. Orders and payments are off while you preview." => "Bara du ser detta. Beställningar och betalningar är avstängda medan du förhandsvisar.";

  // ── VersionSentence ──
  /// VersionSentence · a subtitle
  /// shown through VersionSentence()
  subtitle "Customers see this version whenever no scheduled version is live." => "Kunderna ser den här versionen när ingen schemalagd version är live.";
  /// VersionSentence · a subtitle
  /// placeholders: {from} = from (string), {until} = until (string)
  /// shown through VersionSentence()
  subtitle "Live from {from} until {until}." => "Live från {from} till {until}.";
  /// VersionSentence · a subtitle
  /// placeholders: {from} = from (string)
  /// shown through VersionSentence()
  subtitle "Live from {from}." => "Live från {from}.";
  /// VersionSentence · a subtitle
  /// shown through VersionSentence()
  subtitle "Not live — only staff previewing it see it." => "Inte live – bara personal som förhandsvisar den ser den.";

  // ── VersionState ──
  /// VersionState · a button's label · at most ~10 characters
  /// shown through VersionState()
  button "Live" => "Live";
  /// VersionState · a button's label · at most ~14 characters
  /// shown through VersionState()
  button "Live now" => "Live nu";
  /// VersionState · a button's label · at most ~14 characters
  /// shown through VersionState()
  button "Not live" => "Inte live";
  /// VersionState · a button's label · at most ~15 characters
  /// shown through VersionState()
  button "Scheduled" => "Schemalagd";

  // ── WhereItIs ──
  /// WhereItIs · text on the page
  /// placeholders: {page} = page (string)
  /// shown through WhereItIs()
  text "On {page}" => "På {page}";
  /// WhereItIs · text on the page
  /// placeholders: {page} = page (string)
  /// shown through WhereItIs()
  text "One page per address — {page}" => "En sida per adress – {page}";
}
