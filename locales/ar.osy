  note "Published — customers see it while this version is live." => "تم النشر، ويراه العملاء ما دام هذا الإصدار منشورًا.";
  /// PagesRegionEditor · text on the page
  /// also in PagesMenuEditor
  text "A draft: nobody sees it until you publish it." => "مسودة: لن يراها أحد حتى تنشرها.";
  /// PagesRegionEditor · text on the page
  /// beside: "Cancel"
  text "Add a block" => "إضافة كتلة";
  /// PagesRegionEditor · text on the page
  /// shown through EmptyState.body
  text "Add one — this region shows nothing until you do." => "أضف كتلة، فهذه المنطقة لا تعرض شيئًا حتى تفعل.";
  /// PagesRegionEditor · text on the page
  /// also in PagesMenuEditor
  text "Words in" => "النصوص بلغة";
  /// PagesRegionEditor · a title
  /// shown through EmptyState.title
  title "No blocks" => "لا توجد كتل";

  // ── PagesUploadPicture ──
  /// PagesUploadPicture · text on the page
  /// shown through PagesUploadPicture()
  text "A picture is a JPEG, a PNG or a WebP." => "يجب أن تكون الصورة بصيغة JPEG أو PNG أو WebP.";

  // ── PreviewSentence ──
  /// PreviewSentence · text on the page
  /// placeholders: {version} = version (string)
  /// shown through PreviewSentence()
  text "Previewing {version} as it is now" => "معاينة {version} كما هو الآن";
  /// PreviewSentence · text on the page
  /// placeholders: {version} = version (string)
  /// shown through PreviewSentence()
  text "Previewing {version} as it is now, with drafts" => "معاينة {version} كما هو الآن، مع المسودات";
  /// PreviewSentence · text on the page
  /// placeholders: {version} = version (string), {day} = day (string)
  /// shown through PreviewSentence()
  text "Previewing {version} as of {day}" => "معاينة {version} كما سيكون في {day}";
  /// PreviewSentence · text on the page
  /// placeholders: {version} = version (string), {day} = day (string)
  /// shown through PreviewSentence()
  text "Previewing {version} as of {day}, with drafts" => "معاينة {version} كما سيكون في {day}، مع المسودات";

  // ── RegionState ──
  /// RegionState · a label (a field, a list item, a menu entry) · at most ~14 characters
  /// shown through RegionState()
  label "Arranged" => "مُرتَّبة";
  /// RegionState · a label (a field, a list item, a menu entry) · at most ~26 characters
  /// shown through RegionState()
  label "As the code has it" => "كما في الشيفرة";
  /// RegionState · a label (a field, a list item, a menu entry) · at most ~27 characters
  /// shown through RegionState()
  label "Draft not published" => "مسودة غير منشورة";

  // ── SaveBar ──
  /// SaveBar · a button's label · at most ~10 characters
  /// shown through Button.label
  /// beside: "Unsaved changes", "Discard"
  /// also in PagesInspector
  /// also in PagesMenuEditor
  button "Save" => "حفظ";

  // ── SaveBlock ──
  /// SaveBlock · text on the page
  /// also in PagesUploadPicture
  text "Only a draft can be changed — open the region to edit it." => "لا يمكن تعديل إلا المسودة. افتح المنطقة لتعديلها.";

  // ── SiteLook ──
  /// SiteLook · a control's name for screen readers
  accessibleName "Site preview" => "معاينة الموقع";
  /// SiteLook · a button's label · at most ~30 characters
  /// shown through Button.label
  /// beside: "Only you see this. Orders and payments are off while you preview."
  button "Back to the live site" => "العودة إلى الموقع المنشور";
  /// SiteLook · text on the page
  /// beside: "Back to the live site"
  text "Only you see this. Orders and payments are off while you preview." => "أنت وحدك ترى هذا. الطلبات والمدفوعات متوقفة أثناء المعاينة.";

  // ── StorefrontBagPanel ──
  /// StorefrontBagPanel · a button's label · at most ~11 characters
  /// shown through IconButton.label
  /// also in StorefrontMenuDrawer
  /// also in PagesRegionEditor
  /// also in PagesMenuEditor
  button "Close" => "إغلاق";

  // ── VersionSentence ──
  /// VersionSentence · a subtitle
  /// shown through VersionSentence()
  subtitle "Customers see this version whenever no scheduled version is live." => "يرى العملاء هذا الإصدار كلما لم يكن هناك إصدار مجدول منشور.";
  /// VersionSentence · a subtitle
  /// placeholders: {from} = from (string), {until} = until (string)
  /// shown through VersionSentence()
  subtitle "Live from {from} until {until}." => "منشور من {from} حتى {until}.";
  /// VersionSentence · a subtitle
  /// placeholders: {from} = from (string)
  /// shown through VersionSentence()
  subtitle "Live from {from}." => "منشور من {from}.";
  /// VersionSentence · a subtitle
  /// shown through VersionSentence()
  subtitle "Not live — only staff previewing it see it." => "غير منشور، ولا يراه إلا أعضاء الفريق الذين يعاينونه.";

  // ── VersionState ──
  /// VersionState · a button's label · at most ~10 characters
  /// shown through VersionState()
  button "Live" => "منشور";
  /// VersionState · a button's label · at most ~14 characters
  /// shown through VersionState()
  button "Live now" => "منشور الآن";
  /// VersionState · a button's label · at most ~14 characters
  /// shown through VersionState()
  button "Not live" => "غير منشور";
  /// VersionState · a button's label · at most ~15 characters
  /// shown through VersionState()
  button "Scheduled" => "مجدول";

  // ── WhereItIs ──
  /// WhereItIs · text on the page
  /// placeholders: {page} = page (string)
  /// shown through WhereItIs()
  text "On {page}" => "في {page}";
  /// WhereItIs · text on the page
  /// placeholders: {page} = page (string)
  /// shown through WhereItIs()
  text "One page per address — {page}" => "صفحة لكل عنوان: {page}";
}
