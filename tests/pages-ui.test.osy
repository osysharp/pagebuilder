/// ⭐ A MAIL IS ARRANGED AT THE SAME DESK. Staff open the welcome mail's region, place a quote beside
/// its words and see the MAIL itself — as the mail renderer writes it, on a phone, in a wide reading pane and as its
/// plain text — before they publish; the next member welcomed gets it.
[Test(Cafe)]
void staff_arrange_a_mails_words_and_see_the_mail_itself() {
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Anna);
  Ui.Visit("/staff/pages");
  Assert.Visible("What each mail says");
  Assert.Visible("In the mail Welcome mail", within: "Welcome");
  Ui.Click("Arrange", within: "Welcome");
  Assert.Visible("Welcome to the Corner Café", within: "Preview of the mail");
  Ui.Click("Plain text");
  Assert.Visible("the first cup is on us");
  Ui.Click("Add a block", within: "Blocks");
  Ui.Shot("the mail desk: add a block, each drawn as mail");
  Ui.Click("Add Quote");
  Ui.Click("Change", within: "The What they said field");
  Ui.Fill("What they said", "Best flat white in town, {member.email}.");
  Ui.Click("Save");
  Assert.Visible("Best flat white in town, olle@cafe.test.");
  Ui.Shot("the mail desk: the mail's plain text with the quote");
  Ui.Click("Phone");
  Ui.Shot("the mail desk: the mail on a phone");
  Ui.Click("Wide");
  Ui.Shot("the mail desk: the mail in a wide reading pane");
  // A word the mail does not fill is refused where it is written, by name.
  Ui.Click("Change", within: "The What they said field");
  Ui.Fill("What they said", "Hello {member.name}");
  Ui.Click("Save");
  Assert.Visible("{member.name} is not a placeholder this mail fills");
  Ui.Click("Cancel", within: "The What they said field");
  Ui.Click("Publish");
  Assert.Visible("Published — customers see it while this version is live.");
  // The next member welcomed — rendered as them, who previews nothing — gets the published mail.
  runas (Olle) {
    var mail = WelcomeMail(Member.Single(m => m.Email == "olle@cafe.test"));
    Assert.Contains("Best flat white in town, olle@cafe.test.", mail.Text);
    Assert.False(mail.IsPreview);
  }
}

/// The mail's previews on a desk that is itself phone-width, where the preview sits below the fold: each one is
/// photographed WITH the mail in it — the pixel tier's `Ui.Shot` paints a frame below the fold, so the preview reads as
/// the mail rather than an empty box.
[Test(Cafe)]
void on_a_phone_the_mail_previews_are_photographed_with_the_mail_in_them() {
  Ui.Viewport(390, 844);
  Ui.SignInAs(Anna);
  Ui.Visit("/staff/pages");
  Ui.Click("Arrange", within: "Welcome");
  Assert.Visible("Welcome to the Corner Café", within: "Preview of the mail");
  Ui.Shot("the mail desk on a phone: the mail on a phone");
  Ui.Click("Wide");
  Ui.Shot("the mail desk on a phone: the mail in a wide reading pane");
}
