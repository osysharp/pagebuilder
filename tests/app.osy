// The producer's test project for Osysharp.PageBuilder — a small café site whose front page and campaign pages staff arrange
// at the desk, in English and Swedish.
app PagesKitTests {
  model "model/**/*.osy";
  tests "**/*.test.osy";
  use Osysharp.PageBuilder@1;
  use Osysharp.Blocks;
  // The welcome mail (model/mail.osy) — a mail's region is arranged at the same desk.
  use Osysharp.EmailTemplates@0;
  use Osysharp.Storage;
  use Osysharp.Ui;
}
